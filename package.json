{
  "name": "cycling-training-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H 127.0.0.1",
    "dev:lan": "next dev -H 0.0.0.0",
    "dev:preview": "next dev -H 127.0.0.1 -p 3100",
    "build": "next build",
    "start": "next start -H 127.0.0.1",
    "lint": "eslint --max-warnings 0",
    "test": "vitest run",
    "experiment:fr6": "FR6_RUN_LIVE=1 vitest run scripts/fr6-language-experiment.live.test.ts",
    "test:agent-workflow": "bash scripts/start-agent-task.test.sh && bash scripts/finish-agent-task.test.sh && bash scripts/merge-agent-task.test.sh",
    "test:finish-agent-task": "bash scripts/finish-agent-task.test.sh",
    "test:sync": "bash scripts/sync.test.sh",
    "finish:agent-task": "bash scripts/finish-agent-task.sh",
    "merge:agent-task": "bash scripts/merge-agent-task.sh",
    "start:agent-task": "bash scripts/start-agent-task.sh",
    "sync": "bash scripts/sync.sh",
    "check-links": "node scripts/check-links.mjs",
    "check": "tsc --noEmit && npm run lint && npm test && npm run test:agent-workflow && npm run test:sync && npm run check-links",
    "reset:today": "curl -sf -X POST http://127.0.0.1:3000/api/dev/reset-today && echo 'today-analysis.json cleared' || echo 'Dev server not running on :3000 — start it with npm run dev'"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.104.1",
    "@tanstack/react-query": "^5.101.0",
    "compromise": "^14.15.1",
    "next": "16.2.9",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.8"
  }
}
