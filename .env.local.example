# Copy to .env.local and fill in. The first three are required.
INTERVALS_API_KEY=           # Intervals.icu → Settings → Developer → API key
INTERVALS_ATHLETE_ID=        # Athlete ID, format: i12345
ANTHROPIC_API_KEY=           # console.anthropic.com → API keys

# Optional. A directory to auto-snapshot data/ + knowledge-base/ into after every sync (SUB-4). Point it
# at a folder something else already syncs off this machine (Dropbox, iCloud Drive, a mounted NAS) —
# unset, auto-backup is a no-op (the manual export/import on /settings still works either way).
NODEVELO_BACKUP_DIR=
